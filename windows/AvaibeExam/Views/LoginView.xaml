<UserControl x:Class="AvaibeExam.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="Avaibe Exam"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                           Text="Secure exam client for Windows"/>
                <Separator Margin="0,14,0,14"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Backend URL (https required; http only for localhost)"/>
                <TextBox x:Name="BaseUrlBox" Style="{StaticResource Field}"
                         Text="{Binding BaseUrlText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="BaseUrlLockedText" Style="{StaticResource CaptionText}" Margin="0,4,0,0" Visibility="Collapsed"
                           Text="Set by your school's IT (HKLM\SOFTWARE\Avaibe\Exam). It cannot be changed here."/>

                <StackPanel x:Name="EnrollPanel" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Enrollment token"/>
                    <TextBox x:Name="TokenBox" Style="{StaticResource Field}"
                             Text="{Binding EnrollmentTokenText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="First run on this device (or after an update): the single-use enrollment token is issued by your school's administrator."/>
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Student code"/>
                        <TextBox x:Name="StudentBox" Style="{StaticResource Field}"
                                 Text="{Binding StudentCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Exam code"/>
                        <TextBox x:Name="ExamBox" Style="{StaticResource Field}" CharacterCasing="Upper"
                                 Text="{Binding ExamCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Access code (only if your teacher gave you one)"/>
                    <TextBox x:Name="AccessCodeBox" Style="{StaticResource Field}"
                             Text="{Binding AccessCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Text="Leave this blank if the exam has no access code."/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" Visibility="Collapsed"/>

                <DockPanel Margin="0,18,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="EnrolledText" Style="{StaticResource CaptionText}" Text="Device not enrolled"/>
                        <Button x:Name="ResetButton" Style="{StaticResource LinkButton}" Content="Reset enrollment"
                                HorizontalAlignment="Left" Margin="0,2,0,0" Click="ResetButton_Click"/>
                    </StackPanel>
                    <Button x:Name="ContinueButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            Content="Continue" IsDefault="True" Click="ContinueButton_Click"/>
                    <TextBlock x:Name="BusyText" DockPanel.Dock="Right" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                   Text="Nothing is locked on this screen. Lockdown starts only after the readiness check passes and you press Start Exam."/>
    </Grid>
</UserControl>
