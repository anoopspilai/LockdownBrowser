<UserControl x:Class="AvaibeExam.Views.ExamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvaibeExam.Views"
             Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status strip (CONTRACT §7.3) -->
        <Border Grid.Row="0" Background="{StaticResource StripBrush}">
            <DockPanel Margin="12,0" VerticalAlignment="Center" LastChildFill="True">
                <TextBlock x:Name="LockIcon" DockPanel.Dock="Left" Text="&#x1F512;" FontSize="13" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="DisplaysText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse x:Name="OnlineDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0"/>
                    <TextBlock x:Name="OnlineText" FontSize="11" Foreground="#D1D5DB" Text="Online"/>
                </StackPanel>
                <Border x:Name="BadgeBorder" DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" VerticalAlignment="Center" Margin="14,0,0,0"
                        Background="#3316A34A">
                    <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="Assigned Access"/>
                </Border>
                <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="14" Foreground="White"
                           VerticalAlignment="Center" Text="00:00"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StudentText" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text=" · " FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="ExamText" FontSize="12" Foreground="#E5E7EB"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Exam web view. WebView2 is an HWND (airspace): overlays cannot be drawn over it, so the
             host is hidden whenever an overlay is visible (see ExamView.xaml.cs). -->
        <ContentControl Grid.Row="1" x:Name="WebHost" Focusable="False"/>
        <TextBlock Grid.Row="1" x:Name="LoadingText" Text="Loading exam…" Foreground="White" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

        <views:PauseOverlay Grid.Row="1" x:Name="Pause" Visibility="Collapsed"/>
        <views:WarningOverlay Grid.Row="1" x:Name="Warning" Visibility="Collapsed"/>
        <views:ExitOverlay Grid.Row="1" x:Name="Exit" Visibility="Collapsed"/>
    </Grid>
</UserControl>
