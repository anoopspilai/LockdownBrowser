<UserControl x:Class="AvaibeExam.Views.ExamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AvaibeExam.Views"
             Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Status strip (CONTRACT §7.3 + §10.3 Resources / §10.6 offline time) -->
        <Border Grid.Row="0" Background="{StaticResource StripBrush}">
            <DockPanel Margin="12,0" VerticalAlignment="Center" LastChildFill="True">
                <TextBlock x:Name="LockIcon" DockPanel.Dock="Left" Text="&#x1F512;" FontSize="13" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="DisplaysText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse x:Name="OnlineDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0"/>
                    <TextBlock x:Name="OnlineText" FontSize="11" Foreground="#D1D5DB" Text="Online"/>
                </StackPanel>
                <TextBlock x:Name="OfflineText" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed"/>
                <Border x:Name="BadgeBorder" DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" VerticalAlignment="Center" Margin="14,0,0,0"
                        Background="#3316A34A">
                    <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Text="Assigned Access"/>
                </Border>
                <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="14" Foreground="White"
                           VerticalAlignment="Center" Text="00:00"/>

                <!-- Resources (policy.allowedLinks) + Back to exam + I have finished (external exams, §11.3) -->
                <StackPanel x:Name="ResourcesPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                    <Grid x:Name="ResourcesPicker">
                        <ComboBox x:Name="ResourcesBox" Width="190" Height="22" FontSize="11" DisplayMemberPath="Label"
                                  SelectionChanged="ResourcesBox_SelectionChanged"/>
                        <TextBlock x:Name="ResourcesPlaceholder" Text="Resources ▾" FontSize="11" Foreground="#374151"
                                   Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="BackToExamButton" Content="Back to exam" FontSize="11" Padding="8,2" Margin="6,0,0,0"
                            Cursor="Hand" Visibility="Collapsed" Click="BackToExamButton_Click"/>
                    <Button x:Name="FinishedButton" Content="I have finished" FontSize="11" FontWeight="SemiBold" Padding="10,2" Margin="6,0,0,0"
                            Cursor="Hand" Visibility="Collapsed" Click="FinishedButton_Click"
                            ToolTip="Press this only after you have submitted the test on the exam website."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StudentText" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text=" · " FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock x:Name="ExamText" FontSize="12" Foreground="#E5E7EB"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Blocked-link notice: its own row, so it never overlaps the WebView2 HWND. -->
        <Border Grid.Row="1" x:Name="BlockedNoticeBar" Background="#FEF3C7" Padding="12,6" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button x:Name="NoticeBackButton" DockPanel.Dock="Right" Content="Back to exam" FontSize="11" Padding="8,2"
                        Cursor="Hand" Click="BackToExamButton_Click"/>
                <TextBlock x:Name="BlockedNoticeText" FontSize="12" Foreground="#78350F" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Exam web view. WebView2 is an HWND (airspace): overlays cannot be drawn over it, so the
             host is hidden whenever an overlay is visible (see ExamView.xaml.cs). -->
        <ContentControl Grid.Row="2" x:Name="WebHost" Focusable="False"/>
        <TextBlock Grid.Row="2" x:Name="LoadingText" Text="Loading exam…" Foreground="White" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

        <views:ScriptDialogOverlay Grid.Row="2" x:Name="Dialog" Visibility="Collapsed"/>
        <views:PauseOverlay Grid.Row="2" x:Name="Pause" Visibility="Collapsed"/>
        <views:WarningOverlay Grid.Row="2" x:Name="Warning" Visibility="Collapsed"/>
        <views:ExitOverlay Grid.Row="2" x:Name="Exit" Visibility="Collapsed"/>
    </Grid>
</UserControl>
