<UserControl x:Class="AvaibeExam.Views.PauseOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E6000000">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
        <TextBlock FontSize="44" HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" Text="&#x23F8;"/>
        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" Text="Exam paused"/>
        <TextBlock x:Name="MessageText" FontSize="14" Foreground="#D9FFFFFF" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
