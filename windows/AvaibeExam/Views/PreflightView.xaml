<UserControl x:Class="AvaibeExam.Views.PreflightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Everything except the action bar scrolls, so Start Exam stays visible on small screens. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,28,28,14">

        <!-- Header -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource TitleText}" Text="Readiness check (client-reported)"/>
            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                       Text="Every item below is measured by this client and reported to the server as such. The server makes the final decision."/>
            <TextBlock x:Name="SessionText" Style="{StaticResource BodyText}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            <TextBlock x:Name="PolicyText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Checklist -->
        <Border Style="{StaticResource Card}" Padding="16,8">
            <Grid>
                <ItemsControl x:Name="ItemsList" ItemsSource="{Binding PreflightItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="26" FontSize="18" FontWeight="Bold" Text="{Binding StatusGlyph}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource HeadingText}" Text="{Binding Name}"/>
                                            <Border Margin="8,0,0,0" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Required}" Value="True">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding RequiredText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Required}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" FontSize="12" Margin="0,2,0,0" Text="{Binding Detail}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Notes -->
        <StackPanel Margin="0,14,0,0">
            <TextBlock x:Name="ServerFailuresText" Style="{StaticResource ErrorText}" Visibility="Collapsed" Margin="0,0,0,6"/>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" Margin="0,0,0,6"/>
            <TextBlock x:Name="ModeNoteText" Style="{StaticResource CaptionText}" Visibility="Collapsed" Margin="0,0,0,8"/>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Action bar (pinned) -->
        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,12">
        <StackPanel>
            <TextBlock x:Name="BlockersText" Style="{StaticResource CaptionText}" Foreground="{StaticResource WarningBrush}"
                       Visibility="Collapsed" Margin="0,0,0,8"/>
            <DockPanel LastChildFill="False">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Back" Click="BackButton_Click"/>
                <Button x:Name="RerunButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Content="Re-run checks" Margin="8,0,0,0" Click="RerunButton_Click"/>
                <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource SuccessButton}" Content="Start Exam" Click="StartButton_Click"/>
                <TextBlock x:Name="BusyText" DockPanel.Dock="Right" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </StackPanel>
        </Border>
    </Grid>
</UserControl>
